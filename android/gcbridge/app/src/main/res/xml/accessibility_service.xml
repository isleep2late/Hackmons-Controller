<?xml version="1.0" encoding="utf-8"?>
<!-- Key-event filter only: no window content, no feedback. flagRequestFilterKeyEvents makes
     Android hand every key event (controller buttons included) to onKeyEvent before the app in
     front gets it; the service returns false so nothing is swallowed. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_description" />
